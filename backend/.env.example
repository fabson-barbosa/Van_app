# Banco
DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/vaivem

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
# ATENÇÃO: fora de ENV=development o boot é BLOQUEADO se JWT_SECRET for este
# placeholder ou tiver menos de 32 caracteres (achado A1 da revisão de
# segurança). Todo o isolamento multi-tenant depende de o token ser
# infalsificável — gere um segredo forte, ex.: `python -c "import secrets;
# print(secrets.token_urlsafe(48))"`.
JWT_SECRET=troque-este-valor
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Integrações externas
GOOGLE_MAPS_API_KEY=
FCM_SERVER_KEY=
PAYMENT_GATEWAY_TOKEN=

# App
ENV=development
