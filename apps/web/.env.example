# mock | http  — troque para "http" quando o FastAPI estiver pronto
API_MODE=mock
API_BASE_URL=http://localhost:8000

# Chave de assinatura da sessão. Gere uma nova: openssl rand -base64 32
SESSION_SECRET=troque-esta-chave-por-32-bytes-aleatorios-ok

# Usado por npm run api:types
OPENAPI_URL=http://localhost:8000/openapi.json
