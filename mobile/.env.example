# Ponto único de configuração da baseURL da API (ver src/shared/api/client.ts).
# Copie para .env e ajuste — .env é ignorado pelo git (é específico da sua
# máquina/rede).
#
# Emulador Android (AVD): não precisa setar — o cliente já cai no alias
#   padrão do emulador (10.0.2.2 = localhost da máquina host).
# Aparelho físico via Expo Go: obrigatório. Use o IP da sua máquina na MESMA
#   rede local do celular (não 127.0.0.1, não o IP de adaptadores virtuais
#   como WSL/Hyper-V — confira com `ipconfig`/`Get-NetIPAddress`, o adaptador
#   que está realmente conectado ao roteador).
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.165:8000
